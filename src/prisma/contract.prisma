// use prisma-next
enum UserRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            Uuid           @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())

  refreshTokens RefreshToken[]
  tasks         Task[]
  projects      Project[]
}

model RefreshToken {
  id        Uuid      @id @default(uuid())
  tokenHash String    @unique
  userId    Uuid
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user      User      @relation(fields:[userId], references:[id])

  @@index([userId])
}

model Project {
  id          Uuid      @id @default(uuid())
  userId      Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  user        User      @relation(fields:[userId], references:[id])
  tasks       Task[]

  @@index([userId])
}

model Task {
  id        Uuid          @id @default(uuid())
  userId    Uuid
  projectId Uuid?
  status    TaskStatus    @default(PENDING)
  payload   Jsonb
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now())

  user      User          @relation(fields:[userId], references:[id])
  project   Project?      @relation(fields:[projectId], references:[id])
  auditLogs JobAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([userId, projectId, createdAt, id])
}

model JobAuditLog {
  id            Uuid     @id @default(uuid())
  taskId        Uuid
  attemptNumber Int
  executionTime DateTime
  executionDuration Int?
  exportFilePath String?
  exportRowCount Int?
  createdAt     DateTime @default(now())

  task          Task     @relation(fields:[taskId], references:[id])

  @@index([taskId])
}
